{
  "name": "nest-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A pnpm workspace of drop-in NestJS packages.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "clean": "pnpm -r --filter \"./packages/*\" clean",
    "format": "prettier --write \"packages/*/{src,schematics,test}/**/*.ts\" \"*.md\" \"packages/*/*.md\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^6.0.2"
  }
}
